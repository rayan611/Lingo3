# Server-side only — never exposed to the browser.
#
# Five providers are supported, tried in this order: Gemini, Groq, Mistral,
# DeepSeek, Claude (Anthropic). When one is busy (429), down (5xx), too slow or answers
# something unusable, the same request goes to the next one that has a key.
# With one key set, only that provider is used. Nothing downstream changes:
# entries are normalised to the same shape before they leave api/.
GEMINI_API_KEY=...
GROQ_API_KEY=gsk_...
# Mistral: free key at console.mistral.ai (free plan may use prompts for
# training). MISTRAL_MODEL replaces the default mistral-small-latest.
MISTRAL_API_KEY=...
# DeepSeek: prepaid, very cheap reserve for when Gemini and Groq are spent
# (platform.deepseek.com). DEEPSEEK_MODEL replaces the default deepseek-v4-flash.
DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-v4-flash
ANTHROPIC_API_KEY=sk-ant-...

# Optional: the Groq model. Default openai/gpt-oss-120b. Any Groq chat model
# that supports tool calls works, e.g. llama-3.3-70b-versatile.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: override the model of the FIRST provider (Gemini when its key is
# set). Defaults: gemini-3.8-flash, and claude-haiku-5-5 for the backup. Set a
# stronger model here if genders or verb forms come back wrong — it must match
# the provider whose key is configured.
# LINGUA_MODEL=claude-sonnet-5-5

# Supabase — these are build-time and end up in the browser bundle, which is
# fine: the publishable key grants nothing on its own and every table is
# protected by row-level security. Never put the service-role key here.
VITE_SUPABASE_URL=https://vfximbxcxczntqywdryd.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Cloudflare Turnstile CAPTCHA on sign-in, sign-up and password reset. Public,
# like the key above. Leave unset and no CAPTCHA is shown. ORDER MATTERS: set
# this and deploy FIRST, then turn on CAPTCHA protection in Supabase (Auth ->
# Attack Protection) with the matching SECRET key, which never goes here.
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# Shared hourly AI request limits are enforced atomically by the Lingo3
# Supabase database function; no extra Redis credentials are needed.
