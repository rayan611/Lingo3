{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "dub1"
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/academy-page?root=1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/academy-page?sitemap=1"
    },
    {
      "source": "/academy",
      "destination": "/api/academy-page"
    },
    {
      "source": "/academy/:route*",
      "destination": "/api/academy-page?route=:route*"
    },
    {
      "source": "/api/hub-ai",
      "destination": "/api/ai-status"
    },
    {
      "source": "/((?!api/|assets/|academy\\.html$|showcase\\.html$|version\\.json$|manifest\\.webmanifest$|sw\\.js$|workbox-).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data: blob:; media-src 'self' blob: data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src 'self' https://challenges.cloudflare.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/academy.html",
      "destination": "/academy",
      "permanent": false
    },
    {
      "source": "/academy/levels",
      "destination": "/academy/courses",
      "permanent": true
    }
  ],
  "functions": {
    "api/academy-page.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/academy-page?root=1",
      "override": true
    }
  ]
}
